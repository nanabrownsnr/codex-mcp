# Environment variable template for local/deployed servers. Copy it to `.env`
# and replace every placeholder; never commit the populated `.env` file.

# Application
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_URL=http://localhost:8000
PERSONA_ID_HEADER=Persona-Id

# MongoDB connection storage. Generate an encryption key with:
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=twynity_mcp
ENCRYPTION_KEY=replace-with-generated-fernet-key

# OpenAI Agents API. Use an API key from the same OpenAI project for both keys.
# Keep the application key outside executor containers. The executor key should
# have only permission to connect an environment.
OPENAI_API_KEY=replace-with-openai-project-api-key
OPENAI_EXECUTOR_API_KEY=replace-with-restricted-environment-key
CODEX_MODEL=gpt-6-astra
EXECUTOR_IMAGE=twynity-codex-executor:local
EXECUTOR_NETWORK=bridge
EXECUTOR_MEMORY_LIMIT=8g
AGENT_TASK_TIMEOUT_SECONDS=3600
AGENT_LOCK_SECONDS=3900

# Must be an absolute host path also visible to the Docker daemon and MCP service.
WORKSPACE_ROOT=/srv/twynity-workspaces
WORKSPACE_HOST_ROOT=/srv/twynity-workspaces
DOCKER_GID=999

# Usage reporting
USAGE_REPORT_ENDPOINT=https://example.com/usage

# Account service authentication
ACCOUNT_SERVICE_URL=https://accounts.example.com
ACCOUNT_SERVICE_JWKS_ENDPOINT=/.well-known/jwks.json
ACCOUNT_SERVICE_JWKS_CACHE_TTL=3600

# License service
LICENSE_KEY=replace-me
LICENSE_SERVER_BASE_URL=https://licenses.example.com
LICENSE_SERVER_JWKS_ENDPOINT=/.well-known/jwks.json
LICENSE_SERVER_ACTIVATION_ENDPOINT=/activate
