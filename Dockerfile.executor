FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    git python3 ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global @openai/codex@alpha \
    && mkdir -p /workspace \
    && chown -R node:node /workspace

USER node
WORKDIR /workspace

CMD ["codex", "--help"]
